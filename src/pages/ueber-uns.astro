---
import PageHeader from "../components/PageHeader.astro";
import TeamMember from "../components/TeamMember.astro";
import Layout from "../layouts/Layout.astro";
import { team } from "../data/team";
---

<Layout title="Über uns" description="Das Team der Socius Beistandschaften GmbH in Basel.">
  <PageHeader eyebrow="Über uns" title="Unser Team" />
  <div class="mx-auto grid max-w-6xl gap-x-8 gap-y-14 px-6 py-16 sm:grid-cols-2 md:py-24 lg:grid-cols-3">
    {team.map((member) => (
      <TeamMember member={member} />
    ))}
  </div>
</Layout>
