---
import { Image } from "astro:assets";
import { Mail, Phone } from "@lucide/astro";
import { telHref, type TeamMember } from "../data/team";

interface Props {
  member: TeamMember;
}
const { member } = Astro.props;
---

<article>
  <Image
    src={member.image}
    alt={`Portrait ${member.name}`}
    widths={[400, 600, 900]}
    sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
    class="bg-sand aspect-[3/4] w-full rounded-box object-cover"
  />
  <h3 class="mt-5 text-lg font-medium tracking-tight">{member.name}</h3>
  {member.roles.map((r) => (
    <p class="text-muted text-sm">{r}</p>
  ))}
  <ul class="mt-3 space-y-1 text-sm">
    <li>
      <a href={`mailto:${member.email}`} class="text-ink/80 hover:text-brand inline-flex items-center gap-2 break-all">
        <Mail class="size-4 shrink-0" aria-hidden="true" />
        {member.email}
      </a>
    </li>
    {member.phone && (
      <li>
        <a href={telHref(member.phone)} class="text-ink/80 hover:text-brand inline-flex items-center gap-2">
          <Phone class="size-4 shrink-0" aria-hidden="true" />
          {member.phone}
        </a>
      </li>
    )}
  </ul>
</article>
