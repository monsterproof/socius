---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}
const { title, eyebrow, lead } = Astro.props;
---

<section class="bg-paper border-line border-b">
  <div class="mx-auto max-w-6xl px-6 py-16">
    {eyebrow && <p class="text-brand mb-4 text-xs font-medium tracking-[0.25em] uppercase">{eyebrow}</p>}
    <h1 class="max-w-6xl text-3xl leading-tight font-light tracking-tight text-balance md:text-5xl">{title}</h1>
    {lead && <p class="text-muted mt-6 text-lg text-pretty">{lead}</p>}
  </div>
</section>
